<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="settingRoot" prefHeight="597.0" prefWidth="868.0"
   stylesheets="@../settingView.css" xmlns="http://javafx.com/javafx/21"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkanoid.ui.view.SettingView">
   <children>
      <Slider fx:id="volumeSlider" layoutX="122.0" layoutY="174.0" prefHeight="15.0"
         prefWidth="388.0" showTickLabels="true" value="50.0" />
      <Label fx:id="volumeLabel" layoutX="122.0" layoutY="102.0" prefHeight="38.0" prefWidth="226.0"
         stylesheets="@../settingView.css" text="Music Volume" />
      <Label fx:id="valueLabel" layoutX="594.0" layoutY="174.0" prefHeight="37.0" prefWidth="65.0"
         text="50%" />
      <Button fx:id="okButton" layoutX="588.0" layoutY="479.0" mnemonicParsing="false"
         onMouseClicked="#onOKClick" prefHeight="52.0" prefWidth="158.0" />
      <Button fx:id="cancelButton" layoutX="718.0" layoutY="479.0" mnemonicParsing="false"
         onMouseClicked="#onCancelClick" prefHeight="52.0" prefWidth="158.0" />
   </children>
</AnchorPane>