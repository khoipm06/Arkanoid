<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="shopRoot" prefHeight="597.0" prefWidth="868.0" stylesheets="@../shopView.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.ShopView">
   <children>
      <Label fx:id="lblMoney" layoutX="284.0" layoutY="51.0" prefHeight="78.0" prefWidth="454.0"
         text="Balance:">
         <font>
            <Font size="32.0" />
         </font>
      </Label>
      <Button fx:id="ballButton" layoutX="153.0" layoutY="316.0" mnemonicParsing="false"
         onMouseClicked="#onBallShopClick" prefHeight="86.0" prefWidth="294.0" />
      <Button fx:id="paddleButton" layoutX="582.0" layoutY="316.0" mnemonicParsing="false"
         onMouseClicked="#onPaddleShopClick" prefHeight="71.0" prefWidth="148.0" />
      <Button fx:id="backButton" layoutX="16.0" layoutY="22.0" mnemonicParsing="false"
         onMouseClicked="#onBackClick" text="back" />
      <Button fx:id="depositButton" layoutX="716.0" layoutY="61.0" mnemonicParsing="false"
         onMouseClicked="#onDepositClick" prefHeight="56.0" prefWidth="92.0" text="Deposit" />
      <Label fx:id="lblMessage" layoutX="266.0" layoutY="195.0" prefHeight="56.0" prefWidth="361.0"
         text="Label" visible="false" />
   </children>
</AnchorPane>