<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="shopRoot" prefHeight="537.0" prefWidth="764.0" stylesheets="@../shopView.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.ShopView">
   <children>
      <Label fx:id="lblMoney" layoutX="295.0" layoutY="46.0" prefHeight="64.0" prefWidth="274.0"
         text="Số dư :">
         <font>
            <Font size="31.0" />
         </font>
      </Label>
      <Button fx:id="ballButton" layoutX="135.0" layoutY="284.0" mnemonicParsing="false"
         onMouseClicked="#onBallShopClick" prefHeight="77.0" prefWidth="259.0" />
      <Button fx:id="paddleButton" layoutX="512.0" layoutY="284.0" mnemonicParsing="false"
         onMouseClicked="#onPaddleShopClick" prefHeight="64.0" prefWidth="130.0" />
      <Button fx:id="backButton" layoutX="14.0" layoutY="20.0" mnemonicParsing="false"
         onMouseClicked="#onBackClick" text="back" />
      <Button fx:id="depositButton" layoutX="630.0" layoutY="55.0" mnemonicParsing="false"
         onMouseClicked="#onDepositClick" prefHeight="50.0" prefWidth="81.0" text="Nạp tiền" />
      <Label fx:id="lblMessage" layoutX="278.0" layoutY="193.0" prefHeight="32.0" prefWidth="206.0"
         text="Label" visible="false" />
   </children>
</AnchorPane>