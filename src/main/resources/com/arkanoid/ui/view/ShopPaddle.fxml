<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="597.0" prefWidth="868.0" stylesheets="@../shopPaddle.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.ShopPaddle">
   <children>
      <Button fx:id="backHome" layoutX="53.0" layoutY="65.0" mnemonicParsing="false"
         onMouseClicked="#onBackHomeClick" prefHeight="54.0" prefWidth="64.0" />
      <Button fx:id="buy1" layoutX="468.0" layoutY="202.0" mnemonicParsing="false"
         onMouseClicked="#onBuy1Click" prefHeight="54.0" prefWidth="76.0" />
      <Button fx:id="buy2" layoutX="468.0" layoutY="299.0" mnemonicParsing="false"
         onMouseClicked="#onBuy2Click" prefHeight="54.0" prefWidth="76.0" />
      <Button fx:id="buy3" layoutX="468.0" layoutY="393.0" mnemonicParsing="false"
         onMouseClicked="#onBuy3Click" prefHeight="54.0" prefWidth="76.0" />
      <Button fx:id="equip1" layoutX="673.0" layoutY="199.0" mnemonicParsing="false"
         onMouseClicked="#onEquip1Click" prefHeight="61.0" prefWidth="87.0" />
      <Button fx:id="equip2" layoutX="676.0" layoutY="296.0" mnemonicParsing="false"
         onMouseClicked="#onEquip2Click" prefHeight="54.0" prefWidth="87.0" />
      <Button fx:id="equip3" layoutX="676.0" layoutY="393.0" mnemonicParsing="false"
         onMouseClicked="#onEquip3Click" prefHeight="54.0" prefWidth="87.0" />
      <ImageView fx:id="image1" fitHeight="54.0" fitWidth="188.0" layoutX="94.0" layoutY="190.0"
         pickOnBounds="true" preserveRatio="true" />
      <ImageView fx:id="image2" fitHeight="54.0" fitWidth="188.0" layoutX="102.0" layoutY="296.0"
         pickOnBounds="true" preserveRatio="true" />
      <ImageView fx:id="image3" fitHeight="54.0" fitWidth="188.0" layoutX="102.0" layoutY="393.0"
         pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="titleLabel" layoutX="311.0" layoutY="32.0" prefHeight="54.0" prefWidth="235.0"
         text="Paddle Shop">
         <font>
            <Font size="29.0" />
         </font>
      </Label>
      <Label fx:id="lblMoney" layoutX="232.0" layoutY="119.0" prefHeight="37.0" prefWidth="406.0"
         text="User balance">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
   </children>
</AnchorPane>