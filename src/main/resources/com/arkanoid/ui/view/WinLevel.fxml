<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="521.0" prefWidth="758.0" stylesheets="@../Win.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.WinLevel">
   <children>
      <Button fx:id="nextLevel" layoutX="576.0" layoutY="233.0" mnemonicParsing="false"
         onMouseClicked="#onNextLevelClick" prefHeight="48.0" prefWidth="75.0" />
      <Button fx:id="preLevel" layoutX="124.0" layoutY="236.0" mnemonicParsing="false"
         onMouseClicked="#onPreLevelClick" prefHeight="42.0" prefWidth="47.0" />
      <Label fx:id="score" layoutX="266.0" layoutY="197.0" prefHeight="35.0" prefWidth="226.0"
         text="Score :" />
      <Label fx:id="timePlayed" layoutX="266.0" layoutY="272.0" prefHeight="35.0" prefWidth="171.0"
         text="Time :">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Button fx:id="replay" layoutX="335.0" layoutY="346.0" mnemonicParsing="false"
         onMouseClicked="#onReplayClick" prefHeight="40.0" prefWidth="106.0" />
      <Button fx:id="home" layoutX="335.0" layoutY="427.0" mnemonicParsing="false"
         onMouseClicked="#onHomeClick" prefHeight="40.0" prefWidth="106.0" />
      <ImageView fx:id="winImage" fitHeight="136.0" fitWidth="551.0" layoutX="90.0" layoutY="31.0"
         pickOnBounds="true" preserveRatio="true" />
   </children>
</AnchorPane>