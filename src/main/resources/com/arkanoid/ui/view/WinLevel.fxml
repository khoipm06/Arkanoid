<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane fx:id="root" prefHeight="521.0" prefWidth="758.0" stylesheets="@../Win.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.WinLevel">
   <children>
      <Label fx:id="winLevel" layoutX="306.0" layoutY="65.0" prefHeight="62.0" prefWidth="146.0"
         text="WIN">
         <font>
            <Font size="71.0" />
         </font>
      </Label>
      <Button fx:id="nextLevel" layoutX="576.0" layoutY="233.0" mnemonicParsing="false"
         onMouseClicked="#onNextLevelClick" prefHeight="48.0" prefWidth="75.0" />
      <Button fx:id="preLevel" layoutX="124.0" layoutY="236.0" mnemonicParsing="false"
         onMouseClicked="#onPreLevelClick" prefHeight="42.0" prefWidth="47.0" />
      <Button fx:id="home" layoutX="492.0" layoutY="400.0" mnemonicParsing="false"
         onMouseClicked="#onBackHomeClick" prefHeight="54.0" prefWidth="50.0" />
      <Label fx:id="score" layoutX="279.0" layoutY="194.0" prefHeight="35.0" prefWidth="226.0"
         text="Score :" />
      <Label fx:id="highestScore" layoutX="266.0" layoutY="272.0" prefHeight="35.0" prefWidth="92.0"
         text="Highest Score :" />
   </children>
</AnchorPane>