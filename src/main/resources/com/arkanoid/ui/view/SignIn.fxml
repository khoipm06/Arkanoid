<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootSignIn" prefHeight="525.0" prefWidth="720.0" stylesheets="@../signIn.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.SignIn">
   <children>
      <Label layoutX="215.0" layoutY="96.0" prefHeight="27.0" prefWidth="290.0"
         text="Login to your account">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <TextField fx:id="userNameField" layoutX="332.0" layoutY="188.0" />
      <Label fx:id="user" layoutX="172.0" layoutY="188.0" prefHeight="26.0" prefWidth="80.0"
         text="Username">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="password" layoutX="172.0" layoutY="247.0" prefHeight="33.0" prefWidth="68.0"
         text="Password">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="questions" layoutX="172.0" layoutY="324.0" prefHeight="26.0" prefWidth="185.0"
         text="Don't have an account yet?" />
      <Hyperlink fx:id="signUpClick" layoutX="370.0" layoutY="320.0"
         onMouseClicked="#onSignUpLinkClick" prefHeight="34.0" prefWidth="74.0" text="sign up" />
      <Button fx:id="signInButton" layoutX="481.0" layoutY="420.0" mnemonicParsing="false"
         onMouseClicked="#onSignInClick" prefHeight="46.0" prefWidth="94.0" text="Sign in" />
      <Button fx:id="cancelButton" layoutX="613.0" layoutY="420.0" mnemonicParsing="false"
         onMouseClicked="#onCancelClick" prefHeight="46.0" prefWidth="86.0" text="Cancel" />
      <PasswordField fx:id="passwordField" layoutX="333.0" layoutY="251.0" />
   </children>
</AnchorPane>