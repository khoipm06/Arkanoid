<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="590.0" prefWidth="855.0" stylesheets="@../GameOver.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.GameOver">
   <children>
      <Label fx:id="score" layoutX="253.0" layoutY="206.0" prefHeight="30.0" prefWidth="305.0"
         text="Score: ">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label fx:id="timePlayed" layoutX="253.0" layoutY="264.0" prefHeight="30.0" prefWidth="189.0"
         text="Time: ">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button fx:id="backHome" layoutX="385.0" layoutY="457.0" mnemonicParsing="false"
         onMouseClicked="#onBackHomeClick" prefHeight="48.0" prefWidth="83.0" />
      <Button fx:id="newGame" layoutX="386.0" layoutY="349.0" mnemonicParsing="false"
         onMouseClicked="#onNewGameClick" prefHeight="54.0" prefWidth="83.0" />
      <ImageView fx:id="youLostImage" fitHeight="126.0" fitWidth="366.0" layoutX="223.0"
         layoutY="64.0" pickOnBounds="true" preserveRatio="true" />
   </children>
</AnchorPane>