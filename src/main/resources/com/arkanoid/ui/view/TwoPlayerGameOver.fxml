<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.arkanoid.ui.view.TwoPlayerGameOver"
    alignment="CENTER" spacing="20" stylesheets="@../multiplayer_styles.css">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50" />
    </padding>
    <Label fx:id="winnerLabel" style="-fx-font-size: 24px;" />
    <Label fx:id="player1ScoreLabel" style="-fx-font-size: 18px;" />
    <Label fx:id="player2ScoreLabel" style="-fx-font-size: 18px;" />
</VBox>