<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="authPane" prefHeight="484.0" prefWidth="745.0"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.ProfileScreen">
   <children>
      <AnchorPane fx:id="root" prefHeight="485.0" prefWidth="745.0"
         stylesheets="@../ProfileScreen.css">
         <children>
            <Label fx:id="usernameLabel" layoutX="125.0" layoutY="176.0" prefHeight="32.0"
               prefWidth="266.0" text="username">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label fx:id="balance" layoutX="125.0" layoutY="275.0" prefHeight="32.0"
               prefWidth="277.0" text="balance">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Button fx:id="back" layoutX="25.0" layoutY="23.0" mnemonicParsing="false"
               onMouseClicked="#onBackClick" prefHeight="38.0" prefWidth="41.0" />
            <Button fx:id="logOut" layoutX="582.0" layoutY="398.0" mnemonicParsing="false"
               onMouseClicked="#onLogOutClick" prefHeight="46.0" prefWidth="118.0" />
            <Label fx:id="thongtin" layoutX="228.0" layoutY="70.0" prefHeight="46.0"
               prefWidth="326.0" text="Thông tin người chơi">
               <font>
                  <Font size="30.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>