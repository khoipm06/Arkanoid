<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="authPane" prefHeight="600.0" prefWidth="800.0"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.arkanoid.ui.view.ProfileScreen">
   <children>
      <AnchorPane fx:id="root" prefHeight="600.0" prefWidth="800.0"
         stylesheets="@../ProfileScreen.css">
         <children>
            <!-- Title -->
            <Label fx:id="thongtin" layoutX="200.0" layoutY="20.0" prefHeight="50.0"
               prefWidth="400.0" text="PLAYER PROFILE" alignment="CENTER">
               <font>
                  <Font name="Arial Black" size="32.0" />
               </font>
            </Label>

            <!-- Profile Card Container -->
            <VBox fx:id="profileCard" layoutX="100.0" layoutY="90.0" prefWidth="600.0"
               spacing="15" styleClass="profile-card">
               <children>
                  <!-- User Info Section -->
                  <Label fx:id="usernameLabel" text="Username: Guest" styleClass="info-label">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>

                  <Label fx:id="userIdLabel" text="User ID: 0" styleClass="info-label">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>

                  <Label fx:id="balance" text="Balance: $0" styleClass="balance-label">
                     <font>
                        <Font name="Arial Black" size="22.0" />
                     </font>
                  </Label>

                  <!-- Divider -->
                  <Label text="───────────────────────" styleClass="divider" />

                  <!-- Game Stats Section -->
                  <Label text="GAME STATISTICS" styleClass="section-title">
                     <font>
                        <Font name="Arial Black" size="18.0" />
                     </font>
                  </Label>

                  <Label fx:id="highScoreLabel" text="High Score: 0" styleClass="stat-label">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>

                  <Label fx:id="gamesPlayedLabel" text="Games Played: 0" styleClass="stat-label">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>

                  <Label fx:id="totalScoreLabel" text="Total Score: 0" styleClass="stat-label">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>

                  <Label fx:id="currentSkinLabel" text="Equipped Skin: Default"
                     styleClass="stat-label">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>

                  <!-- Divider -->
                  <Label text="───────────────────────" styleClass="divider" />

                  <!-- Inventory Section -->
                  <Label text="INVENTORY" styleClass="section-title">
                     <font>
                        <Font name="Arial Black" size="18.0" />
                     </font>
                  </Label>

                  <ScrollPane prefHeight="150.0" prefWidth="580.0" styleClass="inventory-scroll"
                     fitToWidth="true">
                     <content>
                        <Label fx:id="inventoryLabel" text="No items yet. Visit the shop!"
                           styleClass="inventory-label" wrapText="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <!-- Back Button -->
            <Button fx:id="back" layoutX="30.0" layoutY="30.0" mnemonicParsing="false"
               onMouseClicked="#onBackClick" prefHeight="50.0" prefWidth="50.0" />

            <!-- Logout Button -->
            <Button fx:id="logOut" layoutX="720.0" layoutY="30.0" mnemonicParsing="false"
               onMouseClicked="#onLogOutClick" prefHeight="50.0" prefWidth="50.0"
               styleClass="logout-button" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>