   <children>
      <Label fx:id="titleLabel" alignment="CENTER" layoutX="179.0" layoutY="19.0" prefHeight="62.0" prefWidth="399.0" text="LEADERBOARD">
         <font>
            <Font name="Arial Black" size="36.0" />
         </font>
      </Label>
      <ListView fx:id="leaderboardList" layoutX="100.0" layoutY="120.0" prefHeight="400.0" prefWidth="600.0" />
      <Button fx:id="backButton" layoutX="30.0" layoutY="30.0" mnemonicParsing="false" onAction="#onBackClick" prefHeight="50.0" prefWidth="50.0" text="Back" />
   </children>
</AnchorPane>
