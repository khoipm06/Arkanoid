<AnchorPane fx:id="settingRoot" prefHeight="532.0" prefWidth="758.0" stylesheets="@../settingView.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkanoid.ui.view.SettingView">
   <children>
