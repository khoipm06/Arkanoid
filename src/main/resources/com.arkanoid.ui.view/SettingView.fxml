      <Label fx:id="valueLabel" layoutX="574.0" layoutY="151.0" prefHeight="33.0" prefWidth="46.0" text="50%" />
      <Button fx:id="okButton" layoutX="522.0" layoutY="445.0" mnemonicParsing="false" onMouseClicked="#onOKClick" prefHeight="34.0" prefWidth="59.0" text="OK" />
