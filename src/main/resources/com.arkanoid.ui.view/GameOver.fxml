<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane fx:id="root" prefHeight="574.0" prefWidth="825.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkanoid.ui.view.GameOver">
   <children>
      <Label fx:id="labelGameOver" layoutX="277.0" layoutY="130.0" prefHeight="47.0" prefWidth="250.0" text="Game Over!">
