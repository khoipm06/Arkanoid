            <Font size="43.0" />
         </font>
      </Label>
      <Label fx:id="score" layoutX="257.0" layoutY="224.0" prefHeight="30.0" prefWidth="305.0" text="Score :">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label fx:id="highestScore" layoutX="257.0" layoutY="279.0" prefHeight="30.0" prefWidth="142.0" text="Highest Score :">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="backHome" layoutX="502.0" layoutY="464.0" mnemonicParsing="false" onMouseClicked="#onBackHomeClick" prefHeight="30.0" prefWidth="52.0" text="home" />
      <Button fx:id="newGame" layoutX="645.0" layoutY="464.0" mnemonicParsing="false" onMouseClicked="#onNewGameClick" text="new game" />
