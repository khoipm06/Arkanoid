<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="597.0" prefWidth="868.0" stylesheets="@../game_styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkanoid.ui.view.MainMenuView">
   <children>
      <Button fx:id="startGame" layoutX="326.0" layoutY="179.0" mnemonicParsing="false" onMouseClicked="#onStartGameClick" prefHeight="95.0" prefWidth="150.0" textAlignment="CENTER">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="settingButton" layoutX="495.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onSettingClick" prefHeight="55.0" prefWidth="40.0">
         <font>
            <Font size="11.0" />
         </font>
      </Button>
      <Button fx:id="quitButton" layoutX="326.0" layoutY="305.0" mnemonicParsing="false" onMouseClicked="#onQuitClick" prefHeight="70.0" prefWidth="239.0">
         <font>
            <Font size="19.0" />
         </font>
      </Button>
      <Button fx:id="shopButton" layoutX="106.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onShopClick" prefHeight="182.0" prefWidth="206.0">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
      <Button fx:id="profileButton" layoutX="294.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onProfileClick" prefHeight="48.0" prefWidth="42.0" />
      <AnchorPane fx:id="modePane" layoutX="300" layoutY="150" prefHeight="200" prefWidth="300" style="-fx-background-color: rgba(0,0,0,0.8); -fx-background-radius: 10;" visible="false">
      </AnchorPane>
      <Button fx:id="leaderBoardButton" layoutX="700.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onLeaderBoardClick" prefHeight="45.0" prefWidth="52.0" />
      <ImageView fx:id="welcome" fitHeight="177.0" fitWidth="796.0" layoutX="72.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" />
   </children>
</AnchorPane>
