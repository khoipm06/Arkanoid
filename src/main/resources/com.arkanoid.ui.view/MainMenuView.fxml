<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="572.0" prefWidth="847.0" stylesheets="@../game_styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkanoid.ui.view.MainMenuView">
   <children>
      <Button fx:id="startGame" layoutX="319.0" layoutY="167.0" mnemonicParsing="false" onMouseClicked="#onStartGameClick" prefHeight="95.0" prefWidth="150.0" textAlignment="CENTER">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="settingButton" layoutX="495.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onSettingClick" prefHeight="55.0" prefWidth="40.0">
         <font>
            <Font size="11.0" />
         </font>
      </Button>
      <Button fx:id="quitButton" layoutX="315.0" layoutY="303.0" mnemonicParsing="false" onMouseClicked="#onQuitClick" prefHeight="70.0" prefWidth="239.0">
         <font>
            <Font size="19.0" />
         </font>
      </Button>
      <Label fx:id="welcome" layoutX="320.0" layoutY="63.0" prefHeight="66.0" prefWidth="206.0" text="Arkanoid" textAlignment="RIGHT" textFill="#07008c">
         <font>
            <Font size="48.0" />
         </font>
      </Label>
      <Button fx:id="shopButton" layoutX="106.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onShopClick" prefHeight="182.0" prefWidth="206.0">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
      <Button fx:id="profileButton" layoutX="294.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onProfileClick" prefHeight="48.0" prefWidth="42.0" />
      <AnchorPane fx:id="modePane" layoutX="300" layoutY="150" prefHeight="200" prefWidth="300" style="-fx-background-color: rgba(0,0,0,0.8); -fx-background-radius: 10;" visible="false">
      </AnchorPane>
      <Button fx:id="leaderBoardButton" layoutX="700.0" layoutY="446.0" mnemonicParsing="false" onMouseClicked="#onLeaderBoardClick" prefHeight="45.0" prefWidth="52.0" />
   </children>
</AnchorPane>
